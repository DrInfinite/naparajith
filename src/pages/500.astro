---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="500" description="there was an unknown server-side error">
  <div class="flex h-[60vh] flex-col place-content-center gap-4">
    <h3 class="text-center">
      500 | the server randomly decided to stop working ;(
    </h3>
    <p class="text-center">
      Try reloading the page or, go home to start over. Sorry for any
      inconviences caused!
    </p>
    <div class="flex place-content-center-safe justify-evenly">
      <button onclick="history.back()" title="Go Back">
        &hookleftarrow; Go Back
      </button>
      <button onclick="location.href = '/'" title="Go Home">
        &HilbertSpace; go home
      </button>
    </div>
  </div>
</Layout>
