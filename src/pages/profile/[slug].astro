-->
<Layout title={about.data.title} description={about.data.title}>
    <main class="min-h-[60vh]">
        <h1>
            {about.data.title}
        </h1>
        <Content />
    </main>
</Layout>

<style>
    h2 {
        @apply bg-linear-to-r from-[#1e57b7] to-[#4762f4] bg-clip-text text-transparent;
    }
</style>
