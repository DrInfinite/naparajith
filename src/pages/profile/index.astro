---
import Layout from '@/layouts/Layout.astro';
import LinksContainer from '@/components/containers/links.astro';
import { getCollection } from 'astro:content';
import { timeSince } from '@/lib/utils';

const profile = await getCollection('profile');
const translations = [
  { lang: 'Sanskrit (Hindi/Marathi)', name: 'नपराजित' },
  { lang: 'Bengali', name: 'নপরাজিৎ' },
  { lang: 'Telugu', name: 'నాపరాజిత్' },
  { lang: 'Tamil', name: 'நபராஜித்' },
  { lang: 'Gujarati', name: 'નાપરાજિત' },
  { lang: 'Kannada', name: 'ನಪರಾಜಿತ್' },
  { lang: 'Odia', name: 'ନାପାରାଜିଥ୍' },
  { lang: 'Malayalam', name: 'നപരാജിത്ത്' },
  { lang: 'Punjabi', name: 'ਨਪਰਾਜਿਤ' },
];
---

<Layout
  title="Profile"
  description="The official profile page for T L Naparajith, a Software Engineer from India"
>
  <h2>{Astro.url.pathname.replace('/', '')}</h2>
  <article>
    <h3>Who I am</h3>
    <p>
      I'm Naparajith, a {timeSince(new Date('2002-11-07')).years} year old Computer
      Programmer/Engineer based out of India. I enjoy working on problems that challenge
      me (piss me off) in a meaningful way. I also work relentlessly towards deepening
      my expertise across the stack.
    </p>
    <p>
      My experience spans software development, engineering, quality assurance,
      test automation, and internal tools.
    </p>
    <p>
      To learn more about my experience, skills, and the tools I use, please
      peruse the sections below:
    </p>

    <LinksContainer>
      {
        profile.map((about) => (
          <span>
            <a href={`/profile/${about.id}`}>{about.data.title}</a>
          </span>
        ))
      }
    </LinksContainer>

    <h3>What I do</h3>
    <ol>
      <li>
        Working with Software Businesses
        <ul>
          <li>Scale sustainably with customer-centric decisions</li>
          <li>Deliver ambitious projects and use data to guide outcomes</li>
        </ul>
      </li>

      <li>
        Working with Product Teams
        <ul>
          <li>Align and contribute across teams (10-100 people)</li>
          <li>
            Communicate effectively with technical and executive stakeholders
          </li>
          <li>Drive measurable project outcomes</li>
        </ul>
      </li>

      <li>
        Continuous Improvement
        <ul>
          <li>Commit to personal and professional growth</li>
          <li>
            Maintain composure under pressure and make high-quality decisions
          </li>
        </ul>
      </li>

      <li>
        Networking and Collaboration
        <ul>
          <li>Engage with developers and discuss emerging technologies</li>
        </ul>
      </li>
    </ol>

    <h3>More about me</h3>
    <p>
      Many people are curious about my name and what it means. So here is your
      answer.
    </p>
    <p>
      The name Naparajith is deeply rooted in ancient Indian culture and roughly
      translates to <strong>
        <em>
          "<u>a person who is undefeated.</u>"
        </em>
      </strong>
    </p>
    <p>
      Here is my name translated into a few regional languages, just as a sign
      of my respect for the immense diversity of this wonderful nation.
    </p>
    <table class="caption-top">
      <caption class="mb-4 font-semibold italic">
        Translations in select Indian languages
      </caption>
      <thead>
        <tr>
          <th>Language</th>
          <th>Name</th>
        </tr>
      </thead>
      <tbody>
        {
          translations.map(({ lang, name }) => (
            <tr>
              <td>{lang}</td>
              <td class="font-sans">{name}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>
      <a href="/contact" title="Contact">Connect</a> for discussions on programming,
      emerging tech, or software product creation. Let's code and innovate together!
    </p>
  </article>
</Layout>
