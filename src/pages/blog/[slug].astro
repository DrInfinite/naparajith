---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import BackIcon from '@/components/icons/Back.astro';
import { getImage, Image, Picture } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Link from '@/components/links/Link.astro';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardFooter,
  CardTitle,
} from '@/components/ui/card.tsx';
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import CTALink from '@/components/links/CTALink.astro';

export const getStaticPaths = (async () => {
  let posts = await getCollection('blog');
  process.env.NODE_ENV === 'development'
    ? (posts = posts.sort(
        (a, b) => b.data.created.getTime() - a.data.created.getTime(),
      ))
    : (posts = posts
        .filter((acc) => acc.data.draft !== true)
        .sort((a, b) => b.data.created.getTime() - a.data.created.getTime()));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const author = await getEntry(post.data.author);
const { Content, remarkPluginFrontmatter } = await render(post);
const postImage = await getImage({ src: post.data.image, format: 'webp' });
---

<Layout
  title={`${post.data.title.toLocaleLowerCase()}`}
  description=`blog post: ${post.data.title} - ${[post.data.description]}`
  ogImage={postImage.src}
>
  <div class="mx-auto w-full max-w-4xl px-6 py-16">
    <Card>
      <CardHeader>
        <CardTitle>{post.data.title}</CardTitle>
        <CardDescription>{post.data.description}</CardDescription>
      </CardHeader>
      <CardContent className="flex flex-row items-center justify-evenly">
        <Image
          src={author.data.image}
          alt={author.data.name}
          inferSize
          priority
          width={48}
          height={48}
          class="-my-2 hidden size-7 rounded-full sm:size-8 md:inline md:size-9 lg:size-10 xl:size-11 2xl:size-12"
        />
        <Link href={author.data.social} title={author.data.name}>
          {author.data.name}
        </Link>
        <p>
          {author.data.occupation}
        </p>
      </CardContent>
      <CardFooter
        className="text-primary/75 -my-4 flex flex-row justify-evenly"
      >
        <p>{remarkPluginFrontmatter.minutesRead}</p>
        <p>{post.data.created.toDateString().slice(4)}</p>
        <p>{remarkPluginFrontmatter.words} words</p>
      </CardFooter>
    </Card>
    <figure>
      <Picture
        src={postImage.src}
        alt={post.data.title}
        inferSize
        width="1920"
        height="1080"
        formats={['webp', 'avif']}
        priority
        class="border-border aspect-square rounded-none border"
        transition:name="image"
      />
      <figcaption class="bg-background text-foreground text-center">
        <span class="font-semibold italic">Image Source: </span><Link
          href={postImage.src}
          title={post.data.title}
          target="_blank"
        >
          {post.data.image_source}
        </Link>
      </figcaption>
    </figure>
    <article>
      <Content />
    </article>
  </div>
</Layout>
