---
import A from "@/components/Link.astro";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getImage, Picture } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import AuthorContainer from "@/components/containers/Author.astro";

export const getStaticPaths = (async () => {
    let posts = await getCollection("blog");
    process.env.NODE_ENV === "development"
        ? (posts = posts.sort(
              (a, b) => b.data.created.getTime() - a.data.created.getTime(),
          ))
        : (posts = posts
              .filter((acc) => acc.data.draft !== true)
              .sort(
                  (a, b) => b.data.created.getTime() - a.data.created.getTime(),
              ));
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const author = await getEntry(post.data.author);
const { Content, remarkPluginFrontmatter } = await render(post);
const postImage = await getImage({ src: post.data.image, format: "webp" });
---

