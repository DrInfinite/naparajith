import A from "@/components/Link.astro";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getImage, Picture } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import AuthorContainer from "@/components/containers/Author.astro";

export const getStaticPaths = (async () => {
    let posts = await getCollection("blog");
    process.env.NODE_ENV === "development"
        ? (posts = posts.sort(
              (a, b) => b.data.created.getTime() - a.data.created.getTime(),
          ))
        : (posts = posts
              .filter((acc) => acc.data.draft !== true)
              .sort(
                  (a, b) => b.data.created.getTime() - a.data.created.getTime(),
              ));
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const author = await getEntry(post.data.author);
const { Content, remarkPluginFrontmatter } = await render(post);
const postImage = await getImage({ src: post.data.image, format: "webp" });
---

<head>
    <meta name="fediverse:creator" content="@naparajith@mastodon.social" />
</head>

<Layout
    title={`${post.data.title}`}
    description=`Blog Post: ${post.data.title} - ${[post.data.description]}`
    ogImage={postImage.src}
>
    <h1 class="text-center font-serif" transition:name="post-title">
        {post.data.title}
    </h1>
    <div
        class="flex grow flex-col justify-evenly gap-4 md:gap-5 lg:gap-6 xl:gap-7 2xl:gap-8"
    >
        <AuthorContainer
            name={author.data.name}
            occupation={author.data.occupation}
            social={author.data.social}
            image={author.data.image}
        />
        <div
            class="flex justify-evenly gap-2 rounded-none border p-2 md:gap-4 md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4"
        >
            <strong
                class="border-l-2 border-gray-400 pl-2 text-gray-400 md:pl-2.5 lg:pl-3 xl:pl-3.5 2xl:pl-4"
            >
                {post.data.created.toDateString().slice(4)}
            </strong>
            <strong>{remarkPluginFrontmatter.minutesRead}</strong>
            <strong>{remarkPluginFrontmatter.words} words</strong>
        </div>
    </div>
    <figure>
        <Picture
            src={postImage.src}
            alt={post.data.title}
            inferSize
            width="1920"
            height="1080"
            formats={["webp", "avif"]}
            priority
            class="aspect-video"
            transition:name="image"
        />
        <figcaption
            class="mt-2 text-center md:mt-2.5 lg:mt-3 xl:mt-3.5 2xl:mt-4"
        >
            <span class="font-semibold italic">Image Source: </span><A
                href={postImage.src}
                title={post.data.title}
                class={"after:content-['_(i)']"}
            >
                {post.data.image_source}
            </A>
        </figcaption>
    </figure>
    <article>
        <p class="font-semibold" transition:name="post-description">
            <span class="text-center">{post.data.description}</span>
        </p>
        <Content />
    </article>
</Layout>
