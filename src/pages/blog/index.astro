-->
<Layout
    title="Blog"
    description="The Official Blog for Naparajith, a Software Engineer from India"
>
    <h2>Articles</h2>
    <main
        class="inline-flex flex-col place-content-center justify-evenly gap-2 md:gap-2.5 lg:flex-row lg:gap-3 xl:gap-3.5 2xl:gap-4"
    >
        {
            posts.map(async (post) => {
                const author = await getEntry(post.data.author);
                return (
                    <ArticleContainer
                        id={post.id}
                        image={post.data.image}
                        title={post.data.title}
                        description={post.data.description}
                        date={post.data.created.toDateString()}
                        author={author.data.name}
                    />
                );
            })
        }
        <!-- <h1>Coming Soon!</h1> -->
    </main>
</Layout>
