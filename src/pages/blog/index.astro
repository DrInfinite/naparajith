import Layout from "@/layouts/Layout.astro";
import ArticleContainer from "@/components/containers/Article.astro";
import { getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

let posts = await getCollection("blog");
process.env.NODE_ENV === "development"
    ? (posts = posts.sort(
          (a, b) => b.data.created.getTime() - a.data.created.getTime(),
      ))
    : (posts = posts
          .filter((acc) => acc.data.draft !== true)
          .sort((a, b) => b.data.created.getTime() - a.data.created.getTime()));

const hydratedPosts = await Promise.all(
    posts.map(async (post) => ({
        post,
        imageSrc: (
            await getImage({
                src: post.data.image,
                format: "webp",
            })
        ).src,
        authorName: (await getEntry(post.data.author)).data.name,
    })),
);
---

<Layout
    title="Blog"
    description="The Official Blog for Naparajith, a Software Engineer from India"
>
    <h2>Articles</h2>
    <main
        class="flex min-h-[60vh] flex-row flex-wrap place-content-center justify-evenly gap-2 md:gap-2.5 lg:gap-3 xl:gap-3.5 2xl:gap-4"
    >
        {
            hydratedPosts.map(({ post, imageSrc, authorName }) => (
                <ArticleContainer
                    id={post.id}
                    image={imageSrc}
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.created.toDateString()}
                    author={authorName}
                />
            ))
        }
        <!-- <h1>Coming Soon!</h1> -->
    </main>
</Layout>
