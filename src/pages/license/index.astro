---
import Layout from "@/layouts/Layout.astro";
import A from "@/components/Link.astro";

const license = [
    {
        href: "https://opensource.org/license/mit",
        name: "The MIT License",
        type: "Source Code License",
    },
    {
        href: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
        name: "CC BY-NC-SA 4.0",
        type: "Site-wide Content License",
    },
    {
        href: "https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode.en",
        name: "CC BY-NC-ND 4.0",
        type: "Site-wide Images License",
    },
];
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<Layout
    title="License"
    description="The official license page for Naparajith's Portfolio, containing a comprehensive list of open-source licenses for code, content and images"
>
    <p>
        This page outlines the various licenses that govern the use of the
        content and assets on this website. As this site built on open and
        transparent principles, I believe it's important to clearly communicate
        the rights and permissions associated with my intellectual property.
    </p>
    <p>
        The image and content licenses are based on the Creative Commons
        framework, which provides a standardized way for creators to grant
        public permissions for the use of their work. The source code license is
        based on the MIT License, which provides a standardized way for source
        code distribution. Please review the details of each license to
        understand the terms and conditions that apply to the corresponding
        content on my site.
    </p>
    <p>
        Below you will find links to the specific licenses covering the site's
        source code, images, and overall content.
    </p>
    <ul>
        {
            license.map((license) => (
                <li>
                    <p>
                        <A href={license.href} title={license.name}>
                            {license.type}
                        </A>{" "}
                        <span>({license.name})</span>
                    </p>
                </li>
            ))
        }
    </ul>

    <h2>Overview of The MIT License</h2>
    <p>
        The MIT License is a permissive software license originating at the
        Massachusetts Institute of Technology (MIT) in the late 1980s.As a
        permissive license, it puts few restrictions on reuse and has high
        license compatibility.
    </p>
    <p>
        Unlike copyleft software licenses, the MIT License allows reuse within
        proprietary software, provided that all copies of the software or its
        substantial portions include a copy of the terms of the MIT License and
        also a copyright notice.
    </p>

    <h2>Overview of Creative Commons</h2>

    <p>
        Creative Commons Corporation (“Creative Commons”) is not a law firm and
        does not provide legal services or legal advice. Distribution of
        Creative Commons public licenses does not create a lawyer-client or
        other relationship. Creative Commons makes its licenses and related
        information available on an “as-is” basis.
    </p>
    <p>
        Creative Commons gives no warranties regarding its licenses, any
        material licensed under their terms and conditions, or any related
        information. Creative Commons disclaims all liability for damages
        resulting from their use to the fullest extent possible.
    </p>
</Layout>
