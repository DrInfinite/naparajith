export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import GitHubCard from "@/components/quick-view/GitHubCard.astro";
import LeetcodeCard from "@/components/quick-view/LeetcodeCard.astro";
import Link from "@/components/Link.astro";
// import LinksContainer from "@/components/containers/Links.astro";

const blog = await getCollection("blog");

const cards = [
    {
        href: "/",
        title: "Portfolio",
        innerHTML: "Portfolio",
    },
    {
        href: "/profile",
        title: "Profile",
        innerHTML: "Profile",
    },
    {
        href: "https://www.linkedin.com/in/naparajith/",
        title: "LinkedIn - Naparajith T L",
        innerHTML: "LinkedIn",
    },
    {
        href: "/design",
        title: "Design",
        innerHTML: "Design",
    },
    {
        href: "/projects",
        title: "Projects",
        innerHTML: "Projects",
    },
    {
        href: "/tools",
        title: "Simple Tools",
        innerHTML: "Tools",
    },
    {
        href: "/quotes",
        title: "Quotes",
        innerHTML: "Quotes",
    },
    {
        href: "https://bsky.app/profile/naparajith.in",
        title: "Naparajith | DrInfinite (@naparajith.in)",
        innerHTML: "BlueSky",
    },
    {
        href: "https://mastodon.social/@naparajith",
        title: "Naparajith | DrInfinite (@naparajjith.mastodon.social)",
        innerHTML: "Mastodon",
    },
];
---

<Layout
    title="Quick View"
    description="A collection of Quick Links for my personal website"
>
    <main
        class="flex flex-col justify-around gap-8 md:gap-10 lg:gap-12 xl:gap-14 2xl:gap-16"
    >
        <article
            class="flex flex-col items-center justify-evenly gap-8 align-middle md:flex-row md:gap-7 lg:gap-6 xl:gap-5 2xl:gap-4"
        >
            <span
                class="-my-px size-48 sm:size-56 md:size-64 lg:size-72 xl:size-84 2xl:size-96"
            >
                <Image
                    alt="DrInfinite"
                    class="mx-auto scale-90 rounded-none"
                    width={480}
                    height={480}
                    priority
                    src="https://avatars.githubusercontent.com/u/74095696?v=4"
                />
            </span>
            <div>
                <h2 class="text-center">Naparajith (Naps) T L</h2>
                <h3 class="text-center">SAFe 6.0 Certified SDET</h3>
            </div>
        </article>

        <hr class="my-2 border md:my-2.5 lg:my-3 xl:my-3.5 2xl:my-4" />

        <div
            class="mt-0 flex flex-col-reverse gap-4 md:flex-col md:gap-4 lg:gap-6 xl:gap-7 2xl:gap-8"
        >
            <div class="mx-auto grid w-full max-w-6xl grid-cols-3 gap-4 p-4">
                {
                    cards.map((card) => (
                        <span class="border border-black p-2">
                            <Link href={card.href} title={card.title}>
                                {card.innerHTML}
                            </Link>
                        </span>
                    ))
                }
            </div>

            <!-- <LinksContainer> -->
            <!--     { -->
            <!--         cards.map((card) => ( -->
            <!--             <Link href={card.href} title={card.title}> -->
            <!--                 {card.innerHTML} -->
            <!--             </Link> -->
            <!--         )) -->
            <!--     } -->
            <!-- </LinksContainer> -->

            <div
                class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-4 p-4 text-left sm:grid-cols-2 md:grid-cols-3"
            >
                <GitHubCard />
                <LeetcodeCard />
                <span class="flex flex-col border border-black p-2">
                    <span>
                        <Link href="/blog" title="Portfolio - Blog"> Blog</Link>
                    </span>
                    <div
                        class="my-2 border border-black transition-all duration-300"
                    >
                    </div>
                    <small class="font-normal">
                        <u>Last Posted:</u>{" "}
                        <strong
                            >{
                                blog.at(0)?.data.created.toDateString().slice(4)
                            }</strong
                        >
                    </small>
                </span>
            </div>
        </div>
    </main>
</Layout>
