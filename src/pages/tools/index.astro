---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/Link.astro";

const tools = [
    {
        url: "number-converter",
        name: "Number Converter",
        description:
            "Convert between binary, decimal, hexadecimal and octal number systems.",
    },
    {
        url: "random-number",
        name: "Random Number Generator",
        description:
            "Generate a random number based on generation rules that you set.",
    },
];
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<Layout
    title="Tools"
    description="A collection of simple tools for everyday tasks"
>
    <h1>Tools</h1>
    <p>A collection of simple tools that make everyday tasks a bit easier.</p>
    {
        tools.map((tool) => (
            <div class="flex w-full flex-col justify-evenly gap-2 rounded-md border p-2 md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4">
                <h4 class="truncate" transition:name="post-title">
                    <Link href={`/tools/${tool.url}`} title={tool.name}>
                        {tool.name}
                    </Link>
                </h4>
                <small>{tool.description}</small>
            </div>
        ))
    }
</Layout>
