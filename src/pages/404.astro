---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404"
  description="the page that you are looking for doesn't exist"
>
  <div class="flex h-[60vh] flex-col place-content-center gap-4">
    <h3 class="text-center">
      404 | the page you are looking for has moved or doesn't exist ;(
    </h3>
    <p class="text-center">
      Try looking for another page or, go home to start over. Sorry for any
      inconviences caused!
    </p>
    <div class="flex place-content-center-safe justify-evenly">
      <button onclick="history.back()" title="Go Back">
        &hookleftarrow; Go Back
      </button>
      <button onclick="location.href = '/'" title="Go Home">
        &HilbertSpace; go home
      </button>
    </div>
  </div>
</Layout>
