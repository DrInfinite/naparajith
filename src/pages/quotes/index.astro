---
import { getCollection } from 'astro:content';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import BackIcon from '@/components/icons/Back.astro';
import CTALink from '@/components/links/CTALink.astro';
import Layout from '@/layouts/Layout.astro';

const quotes = await getCollection('quotes');
const authors = [...new Set(quotes.map((quote) => quote.data.author))];
---

<Layout
  title="quotes"
  description="a collection of quotes by various people that a resonate with"
>
  <div class="mx-auto w-full max-w-4xl px-6 py-16">
    <Header title="quotes">
      A collection of quotes by various people that I resonate with
    </Header>
    <div class="flex flex-col gap-3">
      <h4>Authors</h4>
      {
        authors.sort().map((author) => (
          <CTALink
            href={`/quotes/${author
              .toLowerCase()
              .trim()
              .replace(/[^\w\s-]/g, '')
              .replace(/\s+/g, '-')}`}
            rightTxt={quotes
              .filter((quote) => quote.data.author === author)
              .length.toString()}
          >
            {author}
          </CTALink>
        ))
      }
    </div>
    <aside class="mb-8 text-center">
      <a
        href="/"
        title="back"
        class="group mt-8 -mb-4 inline-flex items-center justify-center gap-2"
      >
        <BackIcon />
        <span class="text-sm tracking-wide">back</span>
      </a>
    </aside>
    <Footer />
  </div>
</Layout>
