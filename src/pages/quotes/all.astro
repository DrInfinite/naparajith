 SPDX-License-Identifier: MIT
-->
<Layout
    title="Quotes I Like"
    description="A collection of quotes that I really like."
>
    <p>
        A collection of quotes by various people that I resonate with and wish
        to share with a wider audience.
    </p>
    {
        quotes.map((quote) => (
            <Quote
                cite={quote.data.cite}
                author={quote.data.author}
                id={quote?.id}
                quoteId={quote?.data.quoteId}
            >
                {quote.data.quote}
            </Quote>
        ))
    }
</Layout>
