 SPDX-License-Identifier: MIT
-->
<Layout title={policy.data.title} description={policy.data.description}>
    <LinksContainer>
        <span>
            Published on <strong>{policy.data.created.toDateString()}</strong>
        </span>
        <span>
            Last updated on <strong
                >{policy.data.updated?.toDateString()}</strong
            >
        </span>
    </LinksContainer>
    <article>
        <Content />
    </article>
</Layout>
