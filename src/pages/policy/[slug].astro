---
import LinksContainer from '@/components/containers/links.astro';
import Layout from '@/layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const policies = await getCollection('policy');
  return policies.map((policy) => ({
    params: { slug: policy.id },
    props: { policy },
  }));
}) satisfies GetStaticPaths;

const { policy } = Astro.props;
const { Content } = await render(policy);
---

<Layout
  title={policy.data.title.toLocaleLowerCase()}
  description={policy.data.description.toLocaleLowerCase()}
>
  <h2>{policy.data.title}</h2>
  <br />
  <LinksContainer>
    <span>
      Published on <strong>{policy.data.created.toDateString()}</strong>
    </span>
    <span>
      Last updated on <strong>{policy.data.updated?.toDateString()}</strong>
    </span>
  </LinksContainer>
  <br />
  <article>
    <Content />
  </article>
</Layout>
