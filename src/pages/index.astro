import Link from "@/components/Link.astro";
import Quote from "@/components/Quote.astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LinksContainer from "@/components/containers/Links.astro";
import { getCollection, getEntry } from "astro:content";
import { formatDate } from "@/utils/helpers";

const learning = [
    "Reading large codebases in a sequential way without getting lost",
    "The intricacies of memory-corruption vulnerabilities",
    "Ethical exploitation of web applications",
    "Building a programming language from scratch",
    "Implementing large, dynamic websites without a significant amount of JavaScript",
    "Building a Web Browser from Scratch",
];

const quotes = await getCollection("quotes");
quotes.sort((a, b) => a.data.author.localeCompare(b.data.author));
const quote = quotes[Math.floor(Math.random() * quotes.length)];

let posts = await getCollection("blog");
if (process.env.NODE_ENV === "production")
    posts = posts.filter((acc) => acc.data.draft !== true);
const post = posts[Math.floor(Math.random() * posts.length)]!;
const post_createdDate = formatDate(post.data.created);

const author = await getEntry(post.data.author);

const pages = [
    { href: "/profile", title: "Profile", label: "Profile" },
    { href: "/quick-view", title: "Quick View", label: "Quick View" },
    { href: "/blog", title: "Blog", label: "Blog" },
    { href: "/quotes", title: "Quotes", label: "Quotes" },
    { href: "/projects", title: "Projects", label: "Projects" },
    { href: "/tools", title: "Tools", label: "Tools" },
    { href: "/design", title: "Design", label: "Design" },
];

const socials = [
    {
        href: "/quick-view/github",
        title: "GitHub - DrInfinite",
        label: "GitHub",
    },
    {
        href: "https://www.linkedin.com/in/naparajith/",
        title: "LinkedIn - Naparajith T L",
        label: "LinkedIn",
        target: "_blank",
    },
    {
        href: "/quick-view/leetcode",
        title: "Leetcode - DrInfinite",
        label: "Leetcode",
    },
    {
        href: "https://bsky.app/profile/naparajith.in",
        title: "Naparajith | DrInfinite (@naparajith.in)",
        label: "BlueSky",
        target: "_blank",
    },
    {
        href: "https://mastodon.social/@naparajith",
        title: "Naparajith | DrInfinite (@naparajjith.mastodon.social)",
        label: "Mastodon",
        target: "_blank",
    },
];
---

<Layout
    title="Home"
    description="The personal portfolio of T L Naparajith, a Software Engineer from India."
>
    <article>
        <figure
            class="flex flex-col content-around items-center justify-around"
        >
            <span
                class="-my-px size-48 sm:size-56 md:size-64 lg:size-72 xl:size-84 2xl:size-96"
            >
                <Image
                    alt="DrInfinite"
                    class="mx-auto scale-90 rounded-none"
                    width={480}
                    height={480}
                    priority
                    src="https://avatars.githubusercontent.com/u/74095696?v=4"
                />
            </span>

            <figcaption
                class="p-2 text-center font-semibold md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4"
            >
                <span class="italic">This image comes from my</span>
                <Link href="https://github.com/DrInfinite" target="_blank">
                    GitHub Profile
                </Link>
            </figcaption>
        </figure>
        <p>
            <strong>
                I'm a software engineer focused on solving meaningful problems
                and continually deepening my expertise across the stack.
            </strong>
        </p>
    </article>

    <!-- <div class="space-y-2 md:space-y-4 lg:space-y-6 xl:space-y-8"> -->
    <LinksContainer>
        {
            pages.map((link) => (
                <Link href={link.href} title={link.title}>
                    {link.label}
                </Link>
            ))
        }
    </LinksContainer>
    <LinksContainer>
        {
            socials.map((link) => (
                <Link
                    href={link.href}
                    title={link.title}
                    target={link.target}
                    rel={
                        link.target === "_blank"
                            ? "noopener noreferrer"
                            : undefined
                    }
                >
                    {link.label}
                </Link>
            ))
        }
    </LinksContainer>
    <p class="text-center font-semibold">
        <Link
            href="https://flowcv.com/resume/mdrssqq018"
            title="Resume"
            target="_blank"
            rel="noopener noreferrer"
        >
            Download my latest Resume
        </Link>
    </p>
    <!-- </div> -->
    <main>
        <div
            class="space-y-4 md:space-y-5 lg:space-y-6 xl:space-y-7 2xl:space-y-8"
        >
            <hr class="my-4 border" />
            <h2>Featured Quote</h2>
            <figure class="place-content-center rounded-none border p-2">
                <Quote cite={quote?.data.cite} author={quote?.data.author!}>
                    {quote?.data.quote}
                </Quote>
                <div class="float-end">
                    <Link href="/quotes" title="Quotes">more like this</Link>
                </div>
            </figure>
            <h2>Featured Blog Post</h2>
            <figure class="place-content-center rounded-none border p-2">
                <article class="flex w-full flex-col gap-2 p-2">
                    <h4 transition:name="post-title">
                        {post.data.title}
                    </h4>
                    <small
                        transition:name="post-description"
                        class="truncate py-2"
                    >
                        {post.data.description}
                    </small>
                    <div class="flex justify-between">
                        <small>{post_createdDate}</small>
                        <small>{author.data.name}</small>
                    </div>
                </article>
                <div class="float-end">
                    <Link href={`/blog/${post.id}`} title="Quotes"
                        >Read Article</Link
                    >
                </div>
            </figure>
            <hr class="my-4 border" />
        </div>
        <div>
            <p>
                When I was a kid, I was told a really inspiring quote about
                learning, which goes something like this:
                <Quote
                    author="Mahābhārata Udyoga Parva 44:16"
                    cite="https://blog.practicalsanskrit.com/2009/12/how-we-learn-and-grow.html"
                >
                    A disciple learns one quarter from the acharya [teacher],
                    one quarter through his own intelligence, one quarter comes
                    to him through the influence of time, and one quarter from
                    his fellow students.
                </Quote>
                I intend to make learning a long-term commitment. Here are a few areas
                I'm actively exploring:
            </p>
            <ul>
                {learning.map((concept) => <li>{concept}</li>)}
            </ul>
            <p>
                If you’d like to collaborate or share feedback on any of these
                topics, please write to
                <Link
                    href="mailto:naparajith@duck.com"
                    title="E-Mail Address"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    naparajith@duck.com
                </Link>.
            </p>
        </div>
    </main>
</Layout>
