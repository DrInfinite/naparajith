---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import CTALink from '@/components/links/CTALink.astro';
import { INTERNAL } from '@/data/links';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="home" description="hi! i'm naps and i break things!!">
  <div
    class="relative flex min-h-screen flex-col items-center justify-center px-6"
  >
    <div class="relative z-10 w-full max-w-xs">
      <Header title="naps">breaks things</Header>
      <nav class="flex flex-col gap-3">
        {
          INTERNAL.HOME.CTA.map((link) => (
            <CTALink href={link.url} title={link.title}>
              {link.title.toLocaleLowerCase()}
            </CTALink>
          ))
        }
      </nav>
      <Footer />
    </div>
  </div>
</Layout>
