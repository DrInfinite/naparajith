---
export const prerender = false;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LinksContainer from '@/components/containers/links.astro';
import ArticleContainer from '@/components/containers/article.astro';
import Quote from '@/components/Quote.astro';
import { getCollection, getEntry } from 'astro:content';
import { links } from '@/data/links';

const learning = [
  'Reading large codebases in a sequential way without getting lost',
  'The intricacies of memory-corruption vulnerabilities',
  'Ethical exploitation of web applications',
  'Building a programming language from scratch',
  'Implementing large, dynamic websites without a significant amount of JavaScript',
  'Building a Web Browser from Scratch',
];

const quotes = await getCollection('quotes');
quotes.sort((a, b) => a.data.author.localeCompare(b.data.author));
const quote = quotes[Math.floor(Math.random() * quotes.length)];

let posts = await getCollection('blog');
posts = posts.filter((post) => post.data.draft !== true);
const post = posts[Math.floor(Math.random() * posts.length)]!;

const author = await getEntry(post.data.author);
---

<Layout
  title="Home"
  description="The personal portfolio of T L Naparajith, a Software Engineer from India."
>
  <article class="space-y-2 md:space-y-4 lg:space-y-6 xl:space-y-8">
    <figure
      class="flex flex-col content-around items-center justify-around gap-4 md:gap-5 lg:gap-6 xl:gap-7 2xl:gap-8"
    >
      <span class="size-48 md:size-60 lg:size-72 xl:size-84 2xl:size-96">
        <Image
          alt="DrInfinite"
          class="rounded-md"
          width={540}
          height={540}
          priority
          src="https://avatars.githubusercontent.com/u/74095696?v=4"
        />
      </span>

      <figcaption
        class="p-2 text-center font-semibold md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4"
      >
        <span class="italic">This image comes from my {' '}</span>
        <a
          href="https://github.com/DrInfinite"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub Profile
        </a>
      </figcaption>
    </figure>

    <p>
      <strong>
        Specialisation is for insects. That's why I'm a generalist, working on
        problems that challenge me (piss me off) in a meaningful way. I also
        work relentlessly towards deepening my expertise across the stack.
      </strong>
    </p>

    <LinksContainer>
      {
        links.home.map((link) =>
          process.env.NODE_ENV === 'development' ? (
            <a href={link.href} title={link.title}>
              {link.title}
            </a>
          ) : (
            !link.draft && (
              <a href={link.href} title={link.title}>
                {link.title}
              </a>
            )
          ),
        )
      }
    </LinksContainer>

    <p class="text-center">
      Before proceeding to interact with this site, parse through its content or
      analyse its source code, <a href="/notice"> please be informed. </a>
    </p>
  </article>

  <main>
    <div class="space-y-8">
      <hr class="my-4 border" />
      <h2>Featured Quote</h2>
      <div class="place-content-center p-2">
        <Quote
          id={quote?.id}
          author={quote?.data.author!}
          cite={quote?.data.cite}
          quoteId={quote?.data.quote}
        >
          {quote?.data.quote}
        </Quote>
        <div class="float-end">
          <a href="/quotes" title="Quotes">more like this</a>
        </div>
      </div>
      <h2>Featured Blog Post</h2>
      <ArticleContainer
        id={post.id}
        image={post.data.image}
        title={post.data.title}
        description={post.data.description}
        date={post.data.created.toDateString()}
        author={author.data.name}
      />
      <hr class="my-4 border" />
    </div>
    <div>
      <p>
        When I was a kid, I was told a really inspiring quote about learning,
        which goes something like this:
      </p>
      <Quote
        author="Mahābhārata Udyoga Parva 44:16"
        cite="https://blog.practicalsanskrit.com/2009/12/how-we-learn-and-grow.html"
      >
        A disciple learns one quarter from the acharya [teacher], one quarter
        through his own intelligence, one quarter comes to him through the
        influence of time, and one quarter from his fellow students.
      </Quote>
      <p>
        I intend to make learning a long-term commitment. Here are a few areas
        I'm actively exploring:
      </p>
      <ul>
        {learning.map((concept) => <li>{concept}</li>)}
      </ul>
      <p>
        If you’d like to collaborate or share feedback on any of these topics,
        please write to{' '}
        <a href="mailto:naparajith@duck.com" title="E-Mail Address">
          naparajith@duck.com
        </a>.
      </p>
    </div>
  </main>
</Layout>
