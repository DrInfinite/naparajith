---
import Layout from '@/layouts/Layout.astro';
import LinksContainer from '@/components/containers/links.astro';
import { socials } from '@/data/links';

const pathname = Astro.url.pathname.replace(/\/+$/, '');
---

<Layout
  title={pathname}
  description="get in touch with me. let's  connect and solve meaningful problems!!"
>
  <h2>{pathname}</h2>
  <p>
    Reach out to me on my social links below (LinkedIn for the fastest
    responses).
  </p>
  <br />
  <LinksContainer>
    {
      socials.map((social) => (
        <span>
          <a href={social.href} title={social.title}>
            {social.label}
          </a>
        </span>
      ))
    }
  </LinksContainer>
  <p>
    If you prefer e-mail, reach out to me on{' '}
    <a href="mailto:naparajith@duck.com" title="E-Mail Address">
      naparajith@duck.com
    </a>.
  </p>
</Layout>
