---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/Link.astro";

const projects: {
    url: string;
    name: string;
    description: string;
    source:
        | "Internal Link"
        | "Codeberg"
        | "GitHub"
        | "GitLab"
        | "External Website";
}[] = [
    {
        url: "https://github.com/basecamp/omarchy",
        name: "Omarchy",
        description: "Opinionated Arch/Hyprland Setup",
        source: "GitHub",
    },
    {
        url: "/tools",
        name: "Tools",
        description:
            "A collection of simple tools that makes everyday tasks just a bit simpler.",
        source: "Internal Link",
    },
];
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<Layout
    title="Projects"
    description="A curated list of technical projects that I have worked on"
>
    <h2>Projects</h2>
    <p>
        A curated list of technical projects that I have worked on / contributed
        to.
    </p>
    {
        projects.map((project) => (
            <div class="flex w-full flex-col justify-evenly gap-2 rounded-md border p-2 md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4">
                <span class="flex justify-between">
                    <h4>
                        <Link href={project.url} title={project.name}>
                            {project.name}
                        </Link>
                    </h4>
                    <small>{project.source}</small>
                </span>
                <strong>{project.description}</strong>
            </div>
        ))
    }
    <p class="italic">
        Very much a work in progress, please don't be shocked by the emptiness
        ;)
    </p>
</Layout>
