---
import Layout from '@/layouts/Layout.astro';

const projects: {
  url: string;
  name: string;
  description: string;
  source: 'Internal Link' | 'GitHub' | 'GitLab' | 'External Website';
}[] = [
  {
    url: 'https://github.com/basecamp/omarchy',
    name: 'Omarchy',
    description: 'Opinionated Arch/Hyprland Setup',
    source: 'GitHub',
  },
];
---

<Layout
  title="projects"
  description="a curated list of technical projects that i have worked on"
>
  <main class="min-h-[60vh]">
    <h2>{Astro.url.pathname.replace('/', '')}</h2>
    <p>
      A curated list of technical projects that I have worked on / contributed
      to.
    </p>
    <br />
    {
      projects.map((project) => (
        <div class="mb-2 flex w-full flex-col justify-evenly gap-2 rounded-md border p-2">
          <div class="flex justify-between">
            <h4>{project.name}</h4>
            <small>{project.source}</small>
          </div>
          <small>{project.description}</small>
          <a href={project.url} class="text-right">
            view
          </a>
        </div>
      ))
    }
    <br />
    <i>
      Very much a work in progress, please don't be shocked by the emptiness ;)
    </i>
  </main>
</Layout>
