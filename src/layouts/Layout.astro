---
import '@/styles/globals.css';

import Footer from '@/components/blocks/footer.astro';
import Header from '@/components/blocks/header.astro';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string | undefined;
}

const { title, description, ogImage } = Astro.props;
const defaultOgImage = '../images/arch-rainbow-1920x1080.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://mastodon.social/@naparajith" rel="me" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {
        Astro.url.pathname === '/'
          ? 'Naparajith (Naps) T L'
          : `${title} | Naps ∘ DrInfinite`
      }
    </title>
    <meta name="description" content={description} />

    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Naparajith" />
    <meta property="og:title" content=`${title} | Naparajith` />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage || defaultOgImage} />

    <meta property="twitter:title" content=`${title} | Naparajith` />
    <meta property="twitter:description" content={description} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-serif-display" preload />
    <Font cssVariable="--font-sans-display" preload />
    <Font cssVariable="--font-quote" preload />
    <Font cssVariable="--font-mono" preload />
  </head>

  <body>
    <Header />
    <main class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />

    <script>
      document.querySelectorAll('a[href^="https"]').forEach((a) => {
        if (a instanceof HTMLAnchorElement) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
      });
    </script>
  </body>
</html>
