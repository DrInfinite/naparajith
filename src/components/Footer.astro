        <span
            >&copy; {year} by <A
                rel="cc:attributionURL dct:creator"
                property="cc:attributionName"
                href="https://gravatar.com/naparajithtl"
                target="_blank"
                title={"Author"}
            >
                Naparajith T L
            </A>.</span
        >
    </span>
