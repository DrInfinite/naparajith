---
import Link from '@/components/links/Link.astro';
import { EXTERNAL_ARRAY } from '@/data/links';
---

<footer
  class="border-border mt-16 flex items-center justify-center gap-x-5 border-t pt-6 tracking-wider"
>
  {
    EXTERNAL_ARRAY.sort((a, b) =>
      a.value.title.localeCompare(b.value.title),
    ).map(({ value: { url, title, icon } }) => (
      <small>
        <Link href={url} title={title}>
          {icon}
        </Link>
      </small>
    ))
  }
</footer>
