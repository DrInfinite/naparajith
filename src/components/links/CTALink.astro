---
import Link from '@/components/links/Link.astro';

type Props = {
  cite?: boolean | null | undefined;
  rightTxt?: string | null | undefined;
} & astroHTML.JSX.AnchorHTMLAttributes;

let { href, id, rel, title, target, rightTxt, cite, ...props } = Astro.props;

const type: 'cite' | 'external' | null = cite
  ? 'cite'
  : typeof href === 'string' &&
      (href.startsWith('http://') || href.startsWith('https://'))
    ? 'external'
    : null;

const internalId =
  (Astro.url.pathname === '/' ? 'home' : Astro.url.pathname) +
  '-' +
  title?.toLocaleLowerCase() +
  '-' +
  (type === 'external' ? 'external' : 'page') +
  '-link';
---

<Link
  class={'group flex items-center justify-between no-underline relative py-3'}
  {...props}
  rel={rel ??
    (type === 'external' || type === 'cite'
      ? 'prefetch noopener noreferrer'
      : 'prefetch')}
  href={href}
  target={target ??
    (type === 'external' || type === 'cite' ? '_blank' : undefined)}
  title={title}
  id={id ?? internalId}
>
  <span><slot /></span>
  <span
    class="text-foreground/40 group-hover:text-primary/50 group-hover:translate-x-0.5"
  >
    {
      rightTxt != null ? (
        rightTxt
      ) : type === 'external' ? (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
        </svg>
      ) : (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
            clip-rule="evenodd"
          />
        </svg>
      )
    }
  </span>
  <span
    class="bg-primary/40 absolute bottom-2 left-0 h-px w-0 duration-300 ease-out group-hover:w-full"
  ></span>
</Link>
