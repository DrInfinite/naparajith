---
type Props = {
  cite?: boolean | null | undefined;
} & astroHTML.JSX.AnchorHTMLAttributes;

let { href, id, rel, title, target, cite, ...props } = Astro.props;

const type: 'cite' | 'external' | null = cite
  ? 'cite'
  : typeof href === 'string' &&
      (href.startsWith('http://') || href.startsWith('https://'))
    ? 'external'
    : null;

const internalId =
  (Astro.url.pathname === '/' ? 'home' : Astro.url.pathname) +
  '-' +
  title?.toLocaleLowerCase() +
  '-' +
  (type === 'external' ? 'external' : 'page') +
  '-link';
---

<a
  {...props}
  rel={rel ??
    (type === 'external' || type === 'cite'
      ? 'prefetch noopener noreferrer'
      : 'prefetch')}
  href={href}
  target={target ??
    (type === 'external' || type === 'cite' ? '_blank' : undefined)}
  title={title}
  id={id ?? internalId}
>
  {
    type === 'cite' ? (
      <cite>
        <slot />
      </cite>
    ) : (
      <slot />
    )
  }
</a>
