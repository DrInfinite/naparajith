import Link from "../Link.astro";
import { GithubProfile } from "@/actions/github-profile";

const updated_at = new Date((await GithubProfile()).updated_at).toDateString();
---

<span class="flex flex-col border border-black p-2">
    <span>
        <Link href="/quick-view/github" title={"GitHub"}>GitHub</Link>
    </span>
    <div class="my-2 border border-black transition-all duration-300"></div>
    <small class="font-normal">
        <u>Updated On:</u>{" "}
        <strong
            >{
                updated_at !== "Invalid Date" ? updated_at.slice(4) : "NA"
            }</strong
        >
    </small>
</span>
