---
import Link from "../Link.astro";
import { LeetcodeProfile } from "@/actions/leetcode-profile.ts";

const leetcode = await LeetcodeProfile();
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<span class="flex flex-col rounded-md border p-2">
    <span>
        <Link href="https://leetcode.com/u/DrInfinite/" title="LeetCode">
            Leetcode
        </Link>
    </span>
    <div class="my-2 border border-black transition-all duration-300"></div>
    <small class="font-normal">
        <u>Last Solved:</u>{" "}
        <strong>
            {
                process.env.NODE_ENV === "development"
                    ? new Date(
                          parseInt(
                              leetcode.recentSubmissionList?.at(0)?.timestamp!,
                          ) * 1000,
                      )
                          .toDateString()
                          .slice(4)
                    : new Date(
                          (parseInt(
                              leetcode.recentSubmissionList?.at(0)?.timestamp!,
                          ) +
                              19800) *
                              1000,
                      )
                          .toDateString()
                          .slice(4)
            }
        </strong>
    </small>
</span>
