---
import Link from "../Link.astro";
import { LeetcodeProfile } from "@/actions/leetcode-profile.ts";

const leetcode = await LeetcodeProfile();
---

<span class="flex flex-col border border-black p-2">
    <span>
        <Link href="/quick-view/leetcode" title="LeetCode"> Leetcode </Link>
    </span>
    <div class="my-2 border border-black transition-all duration-300"></div>
    <small class="font-normal">
        <u>Last Solved:</u>{" "}
        <strong>
            {
                process.env.NODE_ENV === "development"
                    ? new Date(
                          parseInt(
                              leetcode.recentSubmissionList?.at(0)?.timestamp!,
                          ) * 1000,
                      )
                          .toDateString()
                          .slice(4, 10)
                    : new Date(
                          (parseInt(
                              leetcode.recentSubmissionList?.at(0)?.timestamp!,
                          ) +
                              19800) *
                              1000,
                      )
                          .toDateString()
                          .slice(4)
            }
        </strong>
    </small>
</span>
