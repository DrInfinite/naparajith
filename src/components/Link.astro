 SPDX-License-Identifier: MIT
-->
<a
    {...props}
    rel={rel ??
        (type === "external" || type === "cite"
            ? "prefetch noopener noreferrer"
            : "prefetch")}
    href={href}
    target={target ??
        (type === "external" || type === "cite" ? "_blank" : undefined)}
    title={title}
    id={id ?? internalId}
>
    {
        type === "cite" ? (
            <cite>
                - <slot />
            </cite>
        ) : (
            <slot />
        )
    }
</a>
