---
import { Image } from 'astro:assets';

interface Props {
  url: any;
  image: any;
  width: any;
  height: any;
  title: any;
  credits: any;
}

const { url, image, width, height, title, credits } = Astro.props;
---

<div class="block max-w-sm rounded-md border">
  <div
    class="relative mb-2 aspect-square overflow-hidden transition-all duration-200"
  >
    <Image
      src={image}
      alt={title}
      width={width}
      height={height}
      inferSize
      priority
      class="rounded-t-base"
      transition:name="image"
    />
  </div>
  <div class="p-2 text-center">
    <p class="pb-2 font-serif text-xl font-bold">
      <a href={url}>
        {title}
      </a>
    </p>
    <span class="space-x-2"
      >{
        credits.map((credit: any) => (
          <span class="inline-flex items-center rounded-sm border px-1.5 py-0.5 text-xs font-medium">
            <svg
              class="me-1 h-3 w-3"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18.122 17.645a7.185 7.185 0 0 1-2.656 2.495 7.06 7.06 0 0 1-3.52.853 6.617 6.617 0 0 1-3.306-.718 6.73 6.73 0 0 1-2.54-2.266c-2.672-4.57.287-8.846.887-9.668A4.448 4.448 0 0 0 8.07 6.31 4.49 4.49 0 0 0 7.997 4c1.284.965 6.43 3.258 5.525 10.631 1.496-1.136 2.7-3.046 2.846-6.216 1.43 1.061 3.985 5.462 1.754 9.23Z"
              />
            </svg>
            {credit.displayName}
          </span>
        ))
      }</span
    >
  </div>
</div>
