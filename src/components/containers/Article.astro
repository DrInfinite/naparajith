---
import { Image } from "astro:assets";
import Link from "@/components/Link.astro";

interface Props {
    id: any;
    image: any;
    title: any;
    description: any;
    date: any;
    author: any;
}

const { id, image, title, description, date, author } = Astro.props;
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<div
    class="inline-grid grid-cols-1 rounded-md border decoration-transparent md:grid-cols-3"
>
    <!-- Image (1/3) -->
    <div class="col-span-1 p-2">
        <Image
            src={image}
            alt={title}
            inferSize
            width={1920}
            height={1080}
            priority
            class="inline-block aspect-square h-full w-full rounded-md object-cover"
            transition:name="image"
        />
    </div>

    <!-- Content (2/3) -->
    <article
        class="col-span-2 flex flex-col p-2 md:p-2.5 lg:p-3 xl:p-3.5 2xl:p-4"
    >
        <h3 class="truncate" transition:name="post-title">
            <Link href={`/blog/${id}`} title={title}>
                {title}
            </Link>
        </h3>

        <strong class="line-clamp-3" transition:name="post-description">
            {description}
        </strong>

        <div class="mt-auto flex justify-between pt-2">
            <span>{date}</span>
            <span>{author}</span>
        </div>
    </article>
</div>
