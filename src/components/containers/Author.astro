---
import { Image } from "astro:assets";
import Link from "@/components/Link.astro";

interface Props {
    social: any;
    image: string;
    name: any;
    occupation: any;
}

const { social, image, name, occupation } = Astro.props;
---

<span
    class="flex flex-row items-center justify-center gap-2 rounded-none border p-2 no-underline md:gap-2.5 md:p-2.5 lg:gap-3 lg:p-3 xl:gap-3.5 xl:p-3.5 2xl:gap-4 2xl:p-4"
>
    <Image
        src={image}
        alt={name}
        inferSize
        priority
        width={48}
        height={48}
        class="hidden size-6 rounded-full md:inline md:size-7.5 lg:size-9 xl:size-10.5 2xl:size-12"
    />
    <Link href={social} title={name}>{name}</Link>
    <small>
        {occupation}
    </small>
</span>
