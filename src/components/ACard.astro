---
type Props = astroHTML.JSX.AnchorHTMLAttributes;

const { href, title, target, ...props } = Astro.props;
---

<!--
 Copyright Naparajith T L (DrInfinite) 2024, 2026
 SPDX-License-Identifier: MIT
-->
<a
    class="border-border ~p-2/8 hover:bg-foreground/10 active:bg-foreground active:text-background w-full place-self-center rounded-none border no-underline"
    href={href}
    title={title}
    target={target}
    {...props}
>
    <slot />
</a>
