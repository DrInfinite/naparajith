 SPDX-License-Identifier: MIT
-->
<header
    class="my-8 space-y-2 md:space-y-4 lg:space-y-6 xl:space-y-8"
    transition:persist
>
    <span class="flex items-center justify-between gap-4 rounded-md border p-2">
        <strong>
            ~/{
                Astro.url.pathname.startsWith("/blog") ||
                Astro.url.pathname.startsWith("/quotes")
                    ? Astro.url.pathname
                          .toString()
                          .replace("/", "")
                          .replace(/\/.*/, "")
                          .replace("/", "")
                    : Astro.url.pathname.startsWith("/profile")
                      ? Astro.url.pathname
                            .toString()
                            .replace("/", "")
                            .replace(/\/\d+-/, "/")
                      : Astro.url.pathname.toString().replace("/", "")
            }
        </strong>
        <strong>naparajith | sdet 2</strong>
    </span>

    <LinksContainer>
        {
            Astro.url.pathname !== "/" &&
                Astro.url.pathname !== "/quick-view" && (
                    <button onclick="history.back()" title="Go Back">
                        &larr; Back
                    </button>
                )
        }
        {
            links.map((link) => (
                <A href={link.href} title={link.title}>
                    {link.title}
                </A>
            ))
        }
    </LinksContainer>
</header>
