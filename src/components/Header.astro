---
import A from "@/components/Link.astro";
import LinksContainer from "@/components/containers/Links.astro";

const links = [
    { href: "/", title: "Home" },
    { href: "/profile", title: "Profile" },
    { href: "/quick-view", title: "Quick View" },
    { href: "/blog", title: "Blog" },
    { href: "/projects", title: "Projects" },
    { href: "https://flowcv.com/resume/mdrssqq018", title: "Resume" },
].filter((link) => {
    if (Astro.url.pathname.startsWith("/blog/")) {
        return link.title !== "Blog";
    }
    return link;
});
---

<!--
