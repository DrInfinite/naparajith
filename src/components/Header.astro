import A from "@/components/Link.astro";
import Button from "@/components/Button.astro";

const links = [
    { href: "/", title: "Home" },
    { href: "/profile", title: "Profile" },
    { href: "/quick-view", title: "Quick View" },
    { href: "/blog", title: "Blog" },
    { href: "/projects", title: "Projects" },
    { href: "https://flowcv.com/resume/mdrssqq018", title: "Resume" },
];
const linksWithoutBlog = [
    { href: "/", title: "Home" },
    { href: "/profile", title: "Profile" },
    { href: "/quick-view", title: "Quick View" },
    { href: "/projects", title: "Projects" },
    { href: "https://flowcv.com/resume/mdrssqq018", title: "Resume" },
];
---

<header
    class="my-8 space-y-2 md:space-y-4 lg:space-y-6 xl:space-y-8"
    transition:persist
>
    <span class="flex items-center justify-between gap-4 border p-2">
        <strong>
            ~/{
                Astro.url.pathname === "/"
                    ? ""
                    : Astro.url.pathname.startsWith("/blog") ||
                        Astro.url.pathname.startsWith("/quotes")
                      ? Astro.url.pathname
                            .toString()
                            .replace("/", "")
                            .replace(/\/.*/, "")
                            .replace("/", "")
                      : Astro.url.pathname.startsWith("/profile")
                        ? Astro.url.pathname
                              .toString()
                              .replace("/", "")
                              .replace(/\/\d+-/, "/")
                        : Astro.url.pathname.toString().replace("/", "")
            }
        </strong>
        <strong>naparajith | sdet 2</strong>
    </span>

    <span class="flex flex-wrap items-center justify-evenly gap-4 border p-2">
        {
            Astro.url.pathname.startsWith("/blog/") ? (
                <Button href="/blog" title="Go Back">
                    &larr; Back
                </Button>
            ) : (
                <span class="hidden">Back</span>
            )
        }
        {
            Astro.url.pathname.startsWith("/blog/")
                ? linksWithoutBlog.map((link) => (
                      <A href={link.href} title={link.title}>
                          {link.title}
                      </A>
                  ))
                : links.map((link) => (
                      <A href={link.href} title={link.title}>
                          {link.title}
                      </A>
                  ))
        }
    </span>
</header>
